# Run repository tests without executing optimisation rules on the host.
FROM oven/bun:1

RUN apt-get update && apt-get install -y --no-install-recommends git python3-minimal \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/kundol
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

COPY src ./src
COPY registry ./registry
COPY scripts ./scripts
COPY tests ./tests
COPY tsconfig.json eslint.config.mjs ./

RUN mkdir -p /sandbox/home /sandbox/tmp && chown -R bun:bun /sandbox /opt/kundol
ENV HOME=/sandbox/home
ENV TMPDIR=/sandbox/tmp
USER bun

CMD ["bun", "test"]

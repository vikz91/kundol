{
  "name": "kundol",
  "version": "0.3.1",
  "license": "MIT",
  "description": "A Bun + TypeScript CLI for optimising developer storage and project build artifacts.",
  "type": "module",
  "private": true,
  "bin": {
    "kundol": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "check:tools": "bun run scripts/check-tool-versions.ts",
    "lint": "eslint src tests scripts eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build:check": "bun build src/cli/index.ts --target=bun --outfile /dev/null",
    "build:release": "bun run scripts/build-release.ts",
    "smoke:cli": "bun run scripts/smoke-cli.ts",
    "registry:new": "bun run scripts/create-registry-entry.ts",
    "registry:check": "bun run scripts/validate-optimisation-registry.ts",
    "check": "bun run check:tools && bun run lint && bun run typecheck && bun run registry:check && bun test && bun run build:check && bun run smoke:cli",
    "prepare": "husky"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.5",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}

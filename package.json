{
  "name": "kundol",
  "version": "0.1.0",
  "description": "A Bun + TypeScript CLI for optimising developer storage and project build artifacts.",
  "type": "module",
  "private": true,
  "bin": {
    "kundol": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
